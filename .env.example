# Placeholders only. Real values live in Vercel project environment variables.

# Public HTTPS origin of this connector (no trailing slash). Used as the OAuth
# resource identifier: the MCP endpoint is ${PUBLIC_BASE_URL}/mcp
PUBLIC_BASE_URL=https://connector.example.com

# Upstream Argos MCP (legacy HTTP+SSE). Must be https and host must be in the
# code-level allowlist (api.argos.co.uk). Optional; this is the default.
ARGOS_MCP_URL=https://api.argos.co.uk/mcp/sse

# OAuth 2.1 authorization server whose JWT access tokens this connector accepts.
# BLOCKED: no authorization server has been confirmed. Leave unset and the MCP
# endpoint fails closed with 503.
AUTH_ISSUER=
AUTH_JWKS_URL=
# Defaults to ${PUBLIC_BASE_URL}/mcp when unset
AUTH_AUDIENCE=
# Space-separated scopes every token must carry. No scope names have been
# confirmed; leave empty until the authorization server defines them.
AUTH_REQUIRED_SCOPES=
# Comma-separated JWS algorithms accepted (asymmetric only)
AUTH_ALGORITHMS=RS256,ES256

# Comma-separated browser origins allowed to call /mcp. Requests without an
# Origin header (server-to-server) are allowed; requests with any other Origin get 403.
ALLOWED_ORIGINS=

# Per-instance limits (see docs/architecture.md D8)
RATE_LIMIT_PER_SUBJECT_PER_MINUTE=60
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# Upstream timeouts in milliseconds
UPSTREAM_CONNECT_TIMEOUT_MS=8000
UPSTREAM_CALL_TIMEOUT_MS=15000

# debug | info | warn | error
LOG_LEVEL=info
