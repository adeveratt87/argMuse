{
  "name": "argos-muse-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP connector that wraps the Argos product MCP service for Meta Muse",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "ARGOS_LIVE_TESTS=1 vitest run tests/live",
    "dev": "npm run build && node dist/scripts/dev-server.js",
    "audit": "npm audit --omit=dev",
    "discover": "npm run build && node dist/scripts/discover-upstream.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "6.2.12",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
